# Supabase Auth (optional — games run without these via localStorage)
# Project: tonni-games → https://vycergkxkrpsbxoglrws.supabase.co
# Dashboard → Project Settings → API (anon / publishable key)
# Sign-in UI: /account  |  Plan: docs in Project store (sign-in-spike-plan.md)
VITE_SUPABASE_URL=https://vycergkxkrpsbxoglrws.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# After setting keys, enable Google + Email in Supabase Auth and add redirect URLs:
#   http://127.0.0.1:43127/account
#   https://tonni-games.vercel.app/account
# Google Cloud OAuth redirect: https://vycergkxkrpsbxoglrws.supabase.co/auth/v1/callback

# Personal/family NYT Wordle spike (ADR 0009). Default is local Tonni list.
# Set to `nyt` to fetch via same-origin proxy `/api/wordle-nyt/{date}`.
# Or use query: /wordle?source=nyt  (optional archive: &date=YYYY-MM-DD)
# VITE_WORDLE_SOURCE=nyt

# Personal/family NYT Connections spike (ADR 0013). Default is Tonni custom packs.
# Set to `nyt` to fetch via same-origin proxy `/api/connections-nyt/{date}`.
# Or use query: /connections?source=nyt&date=YYYY-MM-DD
# Tonni pack: /connections?source=tonni&puzzle=tonni-starter-1
# VITE_CONNECTIONS_SOURCE=nyt
